.venv/
__pycache__/
*.egg-info/
*.pyc
.pytest_cache/
.DS_Store

# build artifacts
dist/
build/

# Claude Code local state — machine-specific (session ids, pids, local
# overrides). Project-level .claude config (settings.json, agents, skills)
# stays trackable on purpose; only the local state is excluded.
.claude/scheduled_tasks.lock
.claude/settings.local.json
.claude/local/

# Harvested corpus — regenerate with corpus/harvest*.py rather than tracking
# ~10MB of third-party tool descriptions in the repo.
corpus/data/

# Local agent instructions
CLAUDE.md

# Editor-local settings. These encode one contributor's tooling choices
# (which env manager, which interpreter) and should not be imposed on
# anyone else's checkout.
.vscode/
.idea/
